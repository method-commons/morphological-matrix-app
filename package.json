{
  "name": "morphological-matrix-app",
  "private": true,
  "license": "MIT",
  "description": "Morphologische Matrix im Browser – gebaut mit Vite, veröffentlicht über GitHub Pages.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p jsconfig.json && node scripts/typecheck-logic.js",
    "test:unit": "vitest run --coverage --coverage.reporter=text-summary",
    "test:e2e": "playwright test",
    "coverage": "vitest run --coverage",
    "test": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript": "5.9.3",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@method-commons/sync": "git+https://github.com/method-commons/sync.git#v0.5.0",
    "@preact/signals": "2.11.4",
    "fflate": "0.8.3",
    "preact": "10.29.8"
  }
}
